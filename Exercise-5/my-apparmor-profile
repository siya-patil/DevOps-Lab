#include <tunables/global>

/usr/local/bin/python3.12 flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network inet stream,

  capability net_bind_service,
  deny capability sys_admin,

  deny /etc/passwd r,
  deny /etc/shadow r,
  deny /var/** rw,
  deny /bin/** x,
  deny /usr/bin/** x,

  /app/ r,
  /app/** r,
  /usr/local/bin/python3.12 mr,
  /usr/local/lib/** mr,
  /usr/lib/** mr,
  /lib/** mr,
  /etc/ld.so.cache r,
  /etc/ssl/certs/** r,
  /etc/hosts r,
  /etc/hostname r,
  /etc/resolv.conf r,
  /etc/localtime r,
  /proc/** r,
  /dev/null rw,
  /dev/urandom r,
  /dev/zero r,
}